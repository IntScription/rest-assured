EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional. Crash/error reporting stays inert until this is set.
EXPO_PUBLIC_SENTRY_DSN=

# Sentry org/project are already configured in app.json. Set to true only if
# your local machine doesn't have SENTRY_AUTH_TOKEN set (eas secret:create),
# otherwise native builds fail trying to upload source maps without it.
SENTRY_DISABLE_AUTO_UPLOAD=true
