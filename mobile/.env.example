EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional. Crash/error reporting stays inert until this is set.
EXPO_PUBLIC_SENTRY_DSN=

# Set to true until Sentry org/project/SENTRY_AUTH_TOKEN are configured,
# otherwise every native build fails trying to upload source maps.
SENTRY_DISABLE_AUTO_UPLOAD=true
